-- punto 1

/* Reposición de stock
Desarrollar un procedimiento almacenado que permita reponer el stock de un producto.
El procedimiento deberá recibir un producto_id y una cantidad, verificar que el producto exista, 
obtener el stock actual, calcular el nuevo stock luego de la reposición y
 actualizar el valor en la tabla Productos.

Objetos a crear:

Función (UDF): calcularNuevoStock que reciba el stock actual y la cantidad a reponer,
 y retorne el nuevo stock.
Procedimiento almacenado: reponerStockProducto con los parámetros indicados.
Si la operación se realiza correctamente, el procedimiento deberá informar un mensaje de éxito.

En caso de producirse un error, deberá generarse un error controlado mediante 
SIGNAL SQLSTATE '45000'. El procedimiento deberá incluir un HANDLER que capture dicho error, 
registre el motivo en la tabla Auditoria_Errores y luego no relance el error (el error 
ya ha sido manejado y el procedimiento termina normalmente con el mensaje de error). */

DELIMITER //

create function calcularNuevoStock(p_stock_actual int, p_cantidad int)
returns int
deterministic
begin    
    return p_stock_actual + p_cantidad;
end;

create procedure reponerStockProducto(in p_id_producto int, in p_cantidad int)
begin
	declare v_resultado int;
    declare v_stock_actual int;
    declare v_stock_nuevo int;
    
    declare exit handler for sqlstate '45000'
    begin
		select 'el id no existe';
        insert into auditoria_id(procedimiento,operacion,mensaje_error,fecha_error) 
        values ('reponerStockProducto','cargar stock','id inexistente',curdate());
    end;
    
    select
		count(producto_id), stock into v_resultado, v_stock_actual
	from
		productos
	where
		producto_id = p_id_producto;
        
	if(v_resultado = 1) then
		set v_stock_nuevo = calcularNuevoStock(v_stock_actual,p_cantidad);
        
        update productos 
        set stock = v_stock_nuevo
        where producto_id = p_id_producto;
	else
		signal sqlstate '45000';
	end if;
end;

DELIMITER ; 

-- punto 2
/* Actualización de precios
Desarrollar un procedimiento almacenado que permita actualizar el precio de un 
producto aplicando un porcentaje de aumento. El procedimiento deberá recibir un producto_id 
y un porcentaje, verificar que el producto exista, obtener su precio actual, calcular el nuevo 
valor y actualizarlo en la tabla Productos.

Objetos a crear:

Función (UDF): calcularNuevoPrecio que reciba el precio actual y el porcentaje de aumento,y 
retorne el nuevo precio.
Procedimiento almacenado: actualizarPrecioProducto con los parámetros indicados.
Si la operación se realiza correctamente, el procedimiento deberá informar un mensaje de éxito.

En caso de producirse un error, deberá generarse un error controlado mediante 
SIGNAL SQLSTATE '45000'. El procedimiento deberá incluir un HANDLER que capture dicho error, 
registre el motivo en la tabla Auditoria_Errores y luego no relance el error (el error ya ha 
sido manejado y el procedimiento termina normalmente con el mensaje de error). */

DELIMITER //

create function calcularNuevoPrecio(p_precio_actual float,p_aumento float)
returns float
deterministic
begin
	return p_precio_actual *(1 + (p_aumento / 100);
end;

DELIMITER ; 

DELIMITER //

create procedure actualizarPrecioProducto (in p_producto_id int, in p_porcentaje float)
begin
	declare v_resultado int;
    declare v_precio int;
    
    declare exit handler for sqlstate '45000'
    begin
		select 'procudto inexistente';
        insert into auditoria_errores(procedimiento,operacion,mensaje_error,fecha_error)
        values ('actualizarPrecioProducto','actualizar precio','el id no existe',curdate());
    end;
    
    select 
		count(producto_id), precio into v_resultado, v_precio
	from
		productos
	where
		producto_id = p_producto_id;
	group by
		precio;
        
	if(v_resultado = 1) then
		update productos
		set precio = calcularNuevoPrecio(v_precio,p_porcentaje)
        where producto_id = p_producto_id;
        
        select 'carga exitosa';
	else
		signal sqlstate '45000'
	end if;
end;

DELIMITER ;

-- punto 3

/* Información completa de un pedido
Desarrollar un procedimiento almacenado que permita mostrar la información completa de un pedido. 
El procedimiento deberá recibir un pedido_id, verificar que dicho pedido exista y, 
en caso afirmativo, mostrar su identificador, la fecha en la que fue realizado,
 el nombre completo del cliente y el total del pedido. Si el pedido existe pero no tiene
 detalles asociados, el total debe mostrarse como 0 (cero).

Objetos a crear:

Vista: vista_total_pedidos que calcule el total de cada pedido a partir de las tablas 
Detalle_Pedido y Productos.
Función (UDF): obtenerTotalPedido que, dado un pedido_id, consulte la vista y retorne el total
 (0 si no tiene detalles).
Procedimiento almacenado: mostrarInfoPedido que reciba el pedido_id y muestre los datos
 requeridos.
En caso de que el pedido no exista, deberá generarse un error controlado mediante
 SIGNAL SQLSTATE '45000'. El procedimiento deberá incluir un HANDLER que capture dicho error, 
 registre el motivo en la tabla Auditoria_Errores y luego no relance el error
 (el error ya ha sido manejado y el procedimiento termina normalmente con el mensaje de error). */

DELIMITER //

create view vista_total_pedidos as
select
	pro.producto_id,
	sum(dp.cantidad * pro.precio) as total
from
	detalle_pedido as dp join productos as pro
    on dp.producto_id = pro.producto_id
group by
	pro.producto_id;;

DELIMITER ;

DELIMITER //

create function obtenerTotalPedido (p_pedido_id int)
returns float
deterministic
reads sql data
begin
	declare v_total float;
    
    select 
		total 
	from 
		vista_total_pedidos 
	where 
		producto_id = p_pedido_id;
        
	return if null (v_total,0);
end;

DELIMITER ;

DELIMITER //

create procedure mostrarInfoPedido (in p_pedido_id int)
begin
	declare v_resultado int;
    
    declare exit handler for sqlstate '45000'
    begin
		select 'id no encontrado';
		-- insertat en auditoria
    end;
    
    select
		count(pedido_id) into v_resultado
	from
		pedidos
	where
		pedido_id = p_pedido_id;
        
	if(v_resultado = 1) then
		select
			p.pedido_id,
            p.cliente_id,
            p.fecha_pedido,
            c.nombre,
            c.apellido,
            mostrarInfoPedido(p.pedido_id) as total_pedido
		from
			pedidos as p join clientes as c 
            on p.cliente_id = c.cliente_id
	else
		signal sqlstate '45000'
	end if;
end;

DELIMITER ;

/* Registro de detalle con control de stock
Desarrollar un procedimiento almacenado que permita registrar un nuevo detalle de 
pedido controlando que el stock disponible del producto sea suficiente. 
El procedimiento deberá recibir detalle_id, pedido_id, producto_id y cantidad, 
verificar que el pedido y el producto existan, obtener el stock actual, validar 
que haya unidades suficientes, insertar el detalle en la tabla Detalle_Pedido y 
actualizar el stock del producto.

Objetos a crear:

Función (UDF): calcularStockRestante que reciba el stock actual y la cantidad pedida,
y retorne el stock restante.
Procedimiento almacenado: registrarDetallePedido con los cuatro parámetros indicados.
Si la operación se realiza correctamente, el procedimiento deberá informar un mensaje de éxito.

En caso de producirse un error, deberá generarse un error controlado mediante SIGNAL SQLSTATE 
'45000'. El procedimiento deberá incluir un HANDLER que capture dicho error, registre el motivo
 en la tabla Auditoria_Errores y luego no relance el error (el error ya ha sido manejado y 
 el procedimiento termina normalmente con el mensaje de error). */
 
DELIMITER //
 
create function calcularStockRestante (p_stock_actual int, p_cantidad int)
returns int
deterministic
reads sql data
begin
	return p_stock_actual - p_cantidad;
end;
 
DELIMITER ; 
 
DELIMITER //
 
create procedure registrarDetallePedido (in p_detalle_id int, in p_pedido_id int, in p_producto_id int, in p_cantidad int)
begin
	declare v_mensaje_error varcHar(50);
    declare v_stock_actual int;
    
	declare exit handler for sqlstate '45000'
	begin
		rollback;
		select v_mensaje_error;
        insert into auditoria_errores(procedimiento,operacion,mensaje_error,fecha_error)
        values ('registrarDetallePedido','carga id','id no encontrado',curdate())
	end;
    
    start transaction
    
    if no exists(select 1 from productos where producto_id = p_producto_id) then
		set v_mensaje_error = "id de producto no encontrado";
        signal sqlstate '45000';
	end if;
    
    if no exists(select 1 from pedidos where pedido_id = p_pedido_id) then
		set v_mensaje_error = "id de pedido no encontrdo";
        signal sqlstate '45000';
	end if;
    
    select
		stock into v_stock_actual
	from
		prodcutos
	where
		prodcuto_id = p_producto_id;
        
	if(v_stock_actual < p_cantidad) then
		set v_mensaje_error = "la cantidad requerida excede el stock"
        signal sqlstate '45000'
	else
		insert into detalle_pedido(pedido_id,producto_id,cantidad)
        values (p_pedido_id,p_producto_id,p_cantidad);
        
        update productos
        set stock = calcularStockRestante(v_stock_actual,p_cantidad)
        where producto_id = p_producto_id;
        
        commit;
	end if;
end;
 
DELIMITER ; 

-- punto 5
/* Actualización masiva de precios por categoría
Desarrollar un procedimiento almacenado que aplique un descuento del 10% a todos los 
productos de una categoría determinada. El procedimiento deberá recibir el nombre de la categoría.

Objetos a crear:

Procedimiento almacenado: aplicarDescuentoCategoria con un parámetro p_categoria VARCHAR(50).
Se solicita además:

Verificar que la categoría exista (al menos un producto con esa categoría). En caso contrario,
generar un error controlado con SIGNAL SQLSTATE '45000'.
Actualizar el precio de cada producto de esa categoría aplicando el descuento. Para el cálculo 
del nuevo precio, utilizar la función calcularNuevoPrecio desarrollada en el ejercicio 2.
Después de la actualización, insertar un registro en la tabla Auditoria_Operaciones con la 
siguiente información: categoria, fecha_operacion y cantidad_productos_actualizados.
Incluir un manejador de errores que capture cualquier excepción (SQLEXCEPTION), 
registre el error en Auditoria_Errores y luego utilice RESIGNAL para relanzar el mismo error. 
El error relanzado debe propagarse al entorno que llamó al procedimiento.
El procedimiento debe informar un mensaje de éxito si la operación se completa correctamente. */

DELIMITER //

create procedure aplicarDescuentoCategoria (p_categoria VARCHAR(50))
begin
	declare v_mensaje_error varchar(50);
    
	declare handler for sqlexception
    begin
		rollback;
		select 'se ha generado un error';
        insert into auditoria_erorres (procedimiento, operacion,mensaje_error,fecha_error);
        values ('aplicarDescuentoCategoria',      ,v_mensaje_error,curdate());
        resignal;
    end;
    
    declare exit handler for sqlstate '45000'
    begin
		rollback;
		select 'no se ha encontrado la categoria';
        insert into auditoria_erorres (procedimiento, operacion,mensaje_error,fecha_error);
        values ('aplicarDescuentoCategoria','buscar categoria',v_mensaje_error,curdate());
    end;
    
    start transaction
    
    if not exists(select 1 from productos where categoria = p_categoria) then
		set v_mensaje_error = 'categoria no encontrada';
        signal sqlstate '45000';
	end if;
    
    update productos 
    set precio = 
end;

DELIMITER ;

-- punto 6
/* Consulta de stock con manejo de NOT FOUND
Desarrollar un procedimiento almacenado que reciba un producto_id y muestre su nombre y 
stock actual.

Objetos a crear:

Procedimiento almacenado principal: consultarStockProducto con un parámetro p_producto_id INT.
Procedimiento almacenado secundario: notificarStockBajo que reciba producto_id y stock_actual, 
y registre una alerta en la tabla Alertas_Stock.
Se solicita además:

Utilizar una variable local con SELECT ... INTO para obtener el nombre y stock del producto.
Declarar un manejador HANDLER FOR NOT FOUND que, en caso de que el producto no exista
(el SELECT ... INTO no encuentre filas), inserte un registro en Auditoria_Errores 
indicando "Producto no encontrado" y luego lance un error controlado con SIGNAL SQLSTATE '45000'.
Este error no debe ser relanzado adicionalmente, ya que el SIGNAL ya produce la excepción.
Si el producto existe, mostrar por pantalla el nombre y el stock.
Además, si el stock es menor a 5 unidades, llamar al procedimiento notificarStockBajo.
El procedimiento principal debe incluir también un manejador para errores generales (SQLEXCEPTION)
que registre en Auditoria_Errores y luego use RESIGNAL para relanzar el error al entorno 
invocante.
Nota: La tabla Alertas_Stock ya fue creada en el script inicial.

