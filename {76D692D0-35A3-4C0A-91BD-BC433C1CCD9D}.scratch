-- Punto 4

DELIMITER //

create procedure sp_calcular_promedio_entrega_clientes()
begin 
	select
		c.id,
		c.nombre,
        avg(datediff(pe.fecha_estimada_entrega,curdate())) as fecha_promedio_entrega
	from
		clientes as c join pedidos as pe
        on c.id = pe.cliente_id
	group by
		c.id
	order by
		fecha_promedio_entrega desc;
end //

DELIMITER ;
    
