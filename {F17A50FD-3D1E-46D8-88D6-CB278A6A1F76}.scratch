-- Query 5
/*
DELIMITER //

create procedure cambiar_stock (in total_vendido int,out p_id_producto int)
begin

	declare stock_actual int default 0;
    
    select
		stock into stock_actual
	from
		productos
	where
		productos.id = p_id_producto;
        
	update 
		productos 
	set 
		stock = stock_actual - total_vendido
	where 
		id = p_id_producto;

end // 

DELIMITER ;
*/

