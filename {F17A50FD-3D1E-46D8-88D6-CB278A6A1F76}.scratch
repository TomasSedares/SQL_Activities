-- Query 2
/*
DELIMITER //

create procedure obtener_ventas(in fecha_inicio varchar(10), in fecha_final varchar(10))
begin

	select
		nombre,sum(precio)
	from
		productos join detalles_pedido on
        productos.id = detalles_pedido.producto_id and
        detalles_pedido join pedidos on
        detalles_pedido.pedido_id = pedidos.id
	group by
		nombre
	having
		pedidos.fecha_pedido between fecha_inicio and fecha_final;

end //

DELIMITER ; 
