create table empleado(
	codigo int primary key,
    nif char(9),
    nombre varchar(100),
    apellido1 varchar(100),
    apellido2 varchar(100),
    codigo_departamento int(10),
    foreign key (codigo_departamento) references departamento(codigo)
);

create table departamento(
	codigo int primary key,
    nombre varchar(100),
    presupuesto double
);

