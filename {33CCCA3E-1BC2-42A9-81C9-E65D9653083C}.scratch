-- SEGUNDA VERSION

DELIMITER //

CREATE PROCEDURE sp_cargar_articulo_nuevo (
    IN p_nombre VARCHAR(100),
    IN p_precio DECIMAL,
    IN p_id_fabricante INT)
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM producto
        WHERE nombre = p_nombre
    ) THEN
        INSERT INTO producto (nombre, precio, codigo_fabricante)
        VALUES (p_nombre, p_precio, p_id_fabricante);
    END IF;
END //

