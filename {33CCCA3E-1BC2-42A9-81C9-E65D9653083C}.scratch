-- punto 5

DELIMITER //

CREATE PROCEDURE sp_borrar_articulo (IN p_nombre VARCHAR(100))
BEGIN 
	DELETE FROM producto WHERE nombre = p_nombre;
END //

DELIMITER ;

-- punto 6

DELIMITER //

CREATE PROCEDURE sp_actualizar_nombre (IN p_id INT, IN p_nombre VARCHAR(100))
BEGIN 
	UPDATE fabricante
    SET nombre = p_nombre
    WHERE codigo = p_id;
END //

DELIMITER ;

-- Punto 7

DELIMITER //

CREATE PROCEDURE sp_calcular_promedio (IN p_id INT, OUT ps_precio_promedio DECIMAL)
BEGIN
	SELECT 
		AVG(p.precio) as precio_promedio
	FROM
		producto as p join fabricante as f
        on p.codigo_fabricante = f.codigo
	WHERE
		p.codigo_fabricante = p_id;
END //

DELIMITER ;

