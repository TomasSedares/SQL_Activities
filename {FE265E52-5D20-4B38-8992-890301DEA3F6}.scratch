-- punto 1

DELIMITER //

create procedure MostrarDatosMedico (in p_id_medico int)
BEGIN

	DECLARE v_id_medico int;
    DECLARE nombre_medico varchar(50);
    DECLARE nombre_especialidad varchar(50);
    DECLARE matricula int;
    
    SET v_id_medico = p_id_medico;
    
	SELECT 
		m.nombre, m.matricula, e.nombre_matricula into nombre_medico,nombre_especialidad,matricula
	from 
		medicos as m join especialidades as e
        on m.especialidads_id = e.especialidad_id
	where
		medico_id = v_id_medico;
END//

DELIMITER ; 

-- punto2
DELIMITER //
	
create procedure ObtenerNombreMedico (in p_id_medico int, out p_nombre_medico varchar(50), out p_nombre_especialidad varchar(50))
begin 
	select
		m.nombre, e.nombre into p_nombre_medico,p_nombre_especialidad
	from
		medicos as m join especialidades as e
        on m.especialidad_id = e.especialidad_id
	where
		m.medico_id = p_id_medico;
end; 

DELIMITER // 

call ObtenerNombreMedico(1,@s_nombre_medico,@s_nombre_especialidad);

select
	@s_nombre_medico, @s_nombre_especialidad;
    
-- punto3  HAY QUE HACER 2 VARIANTES DEL PUNTO 3, UNO USANDO EXISTS Y OTRO CON COUNT

DELIMITER //
create procedure VerificarMedico (in p_id_medico int)
begin
	select 
		medico_id into p_id_medico;
		if
			p_id_medico is null then 
            select 'el medico con el id solicitado no existe';
		else
			concat ('el medico es',' ',nombre)
	from
		medicos
end;

DELIMITER ;

-- punto 4

DELIMITER //
create procedure ClasificarMedico (in p_id_medico int)
begin 

	declare v_medico_salario float;
    set v_medico_salario = m.salario;
    
	select 
		m.nombre,
        m.salario,
		case 
			when v_medico_salario < 200000 then 'salario bajo'
            when v_medico_salario < 200000 and v_medico_salario > 500000 then 'salario medio'
            when v_medico_salario > 500000 then 'salario alto'
		end as clasificacion_salarial
	from 
		medicos as m;
end;

DELIMITER ;

-- punto 5

DELIMITER //
create procedure RegistrarTurno (in p_paciente_id int, in p_medico_id int, in p_fecha date, in p_motivo varchar(50), out p_turno_id int)
begin
	declare v_ultimo_id int;
    
	insert into turnos (paciente_id, medico_id, fecha, motivo, estado)
    values (p_paciente_id, p_medico_id, p_fecha, p_motivo, 'pendiente');
    
     
	set	v_ultimo_id = LAST_INSERT_ID;
    set p_turno_id = v_ultimo_id;
    
    select 
		concat ('el ultimo id ingresado es',' ', v_ultimo_id);
end ;
DELIMITER ;

-- PUNTO 6 //CORREGIR

DELIMITER //
create procedure CancelarTurno (in p_turno_id int, out p_filas_afectadas int)
begin
	
    if p_turno_id exists (select turno_id from turnos) and (select estado from turnos where turno_id = p_turno_id) like 'pendiente' then concat ('la cantidad de filas alteradas son:', ' ', row_count())
    else select 'error';
    
    set p_filas_afectadas = row_count();
end;
DELIMITER ;