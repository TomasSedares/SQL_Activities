-- Ejercicio 1:
/* Crear una vista llamada clientes_por_ciudad que muestre el nombre completo de los clientes
y su email, filtrando por una ciudad específica (por ejemplo, 'Madrid').
Utilizar WITH CHECK OPTION para asegurarnos de que no se puedan insertar o actualizar
clientes a través de esta vista que no pertenezcan a la ciudad filtrada. */

create view clientes_por_ciudad as
select 
	nombre,
    apellido,
    email
from 
	clientes
where 
	ciudad = 'Madrid' with check option;

select * from clientes_por_ciudad;

-- Ejercicio 2:
/* Crear una vista llamada resumen_ventas_categoria que muestre la categoría de productos y
el total de ventas (suma de cantidades) para cada categoría (JOIN entre las tablas Productos
y Detalle_Pedido). */

drop view resumen_ventas_categoria;

create view resumen_ventas_categoria as
select 
	prod.categoria,
    sum(det_ped. cantidad)
from
	detalle_pedido as det_ped join productos as prod
    on det_ped.producto_id = prod.producto_id
group by
	prod.categoria;

select * from resumen_ventas_categoria;

-- Ejercicio 3:
/* Crear una vista llamada clientes_total_pedidos que muestre el nombre completo de los
clientes y el número total de pedidos realizados por cada cliente (JOIN entre las tablas
Clientes y Pedidos y función COUNT()). */

drop view clientes_total_pedidos;

create view clientes_total_pedidos as
select 
	c.nombre,
    c.apellido,
    count(det.pedido_id) as cantidad_pedidos
from
    detalle_pedido as det join pedidos as p
    on det.pedido_id = p.pedido_id join clientes as c
    on p.cliente_id = c.cliente_id
group by	
	c.nombre,
    c.apellido;
    
select * from clientes_total_pedidos;

-- Ejercicio 4:
/* Crear una vista llamada productos_mas_vendidos_ciudad que muestre la ciudad, el nombre
del producto y la cantidad total vendida de cada producto en cada ciudad (JOIN entre las
tablas Clientes, Pedidos y Detalle_Pedido, y funciones SUM() y GROUP BY). */

drop view productos_mas_vendidos_ciudad;

create view productos_mas_vendidos_ciudad as
select 
	c.ciudad,
    pro.nombre_producto,
    sum(det.cantidad) as cantidad_vendidos
from
	detalle_pedido det join pedidos p 
    on det.pedido_id = p.pedido_id join clientes c 
    on p.cliente_id = c.cliente_id join productos pro 
    on det.producto_id = pro.producto_id
group by
	c.ciudad,
    pro.nombre_producto;
    
select * from productos_mas_vendidos_ciudad;

-- Ejercicio 5:
/* Crear una vista llamada ingresos_por_mes que muestre el mes y año (en formato "YYYYMM") 
y el total de ingresos generados en ese mes (JOIN entre las tablas Pedidos,
Detalle_Pedido y Productos, y funciones SUM() y DATE_FORMAT()). */

drop view ingresos_por_mes;

create view ingresos_por_mes as
select 
	sum(det.cantidad * pro.precio) as ingresos_totales,
    date_format(p.fecha_pedido,'%Y/%m') as fecha
from
	pedidos as p join detalle_pedido as det
    on p.pedido_id = det.pedido_id join productos as pro
    on det.producto_id = pro.producto_id
group by 
	fecha;
    
select * from ingresos_por_mes;

-- Ejercicio 6:
/* 1. Crear una vista llamada productos_electronicos que muestre solo los productos de la
categoría 'Electrónicos'.
2. Crear otra vista llamada ventas_electronicos que se base en productos_electronicos y
muestre los detalles de los pedidos de productos electrónicos.
Utilizar WITH LOCAL CHECK OPTION en la vista ventas_electronicos. */

drop view productos_electronicos;
drop view ventas_electronicos;

create view productos_electronicos as
select 
	*
from 
	productos 
where
	categoria = 'Electrónicos';

create view ventas_electronicos as
select 
	*
from
	detalle_pedido
where
	producto_id in (select producto_id from productos_electronicos)
    WITH LOCAL CHECK OPTION;

select * from ventas_electronicos;

-- Ejercicio 7:
/* Repetir el ejercicio anterior, pero esta vez utilizar WITH CASCADE CHECK OPTION en la vista
ventas_electronicos. */

drop view productos_electronicos;
drop view ventas_electronicos;

create view productos_electronicos as
select 
	*
from 
	productos 
where
	categoria = 'Electrónicos';

create view ventas_electronicos as
select 
	*
from
	detalle_pedido
where
	producto_id in (select producto_id from productos_electronicos)
    WITH CASCADED CHECK OPTION;

select * from ventas_electronicos;



